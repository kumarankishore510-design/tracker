# ==========================================
# SKS Travels Environment Variables
# ==========================================

# Server Port
PORT=3001

# Admin Master Password (Override for production)
ADMIN_PASSWORD=admin123

# Optional Supabase Integration (PostgreSQL database & Auth)
# If provided, the system seamlessly connects to your cloud Supabase instance.
# If omitted, SKS Travels persists directly to high-performance local SQLite database (sks_travels.sqlite).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Company Contact Overrides (Optional, editable in Admin Dashboard)
VITE_COMPANY_PHONE=+919442012345
VITE_WHATSAPP_NUMBER=+919442012345
VITE_COMPANY_EMAIL=bookings@skstravels.com
